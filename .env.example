REMOVAL_EMAIL=

# Where scripts/deploy.mjs deploys: the Vercel team and project IDs
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Accounts database (users and their applied marks); tables in db/schema.sql
DATABASE_URL=
# Signs session cookies: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional: Google sign-in (OAuth web client; redirect URI <site>/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: emails header feedback to REMOVAL_EMAIL via Resend (sender domain hassandev.me)
RESEND_API_KEY=
