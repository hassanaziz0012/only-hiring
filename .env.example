REMOVAL_EMAIL=

# Optional: Cloudflare Web Analytics site token (dashboard: Analytics & Logs > Web Analytics). Read at build time.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# Optional: Sentry DSN for browser error reports. Read at build time.
NEXT_PUBLIC_SENTRY_DSN=

# The Worker's settings. In production they're Worker secrets (README.md, "Hosting on Cloudflare"); for
# `npm run dev:worker`, put them in .dev.vars, with EXTRA_HOSTS="localhost:*".

# Accounts database (users and their applied marks); tables in db/schema.sql
DATABASE_URL=
# Signs session cookies: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional: Google sign-in (OAuth web client; redirect URI <site>/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: emails header feedback to REMOVAL_EMAIL via Resend (sender domain hassandev.me)
RESEND_API_KEY=

# Optional: Sentry DSN for the Worker's error reports (a Worker secret: `npx wrangler secret put SENTRY_DSN`)
SENTRY_DSN=
